<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The hardened runtime ignores DYLD_INSERT_LIBRARIES, so other software cannot inject a library into the
	     wallet. Its library validation would also refuse the libraries of the app, which carry an ad hoc signature
	     without a team: the Monero library, which the user may replace under LGPL-3.0, and the frameworks of
	     Flutter. CHECKED 7 Oct 2026 on macOS 26: with this key an ad hoc process of the hardened runtime loads an
	     ad hoc library, and DYLD_INSERT_LIBRARIES still loads nothing. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
